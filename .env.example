# Diyanet İşleri Başkanlığı Açık Kaynak Kur'an API ayarları
# Token almak için: https://acikkaynakkuran-dev.diyanet.gov.tr
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin. .env asla commit edilmez.
DIB_KURAN_API_BASE_URL=https://api.diyanet.gov.tr
DIB_KURAN_API_TOKEN=buraya_kendi_tokeninizi_yazin

# İsteğe bağlı
# DIB_KURAN_LANGUAGE=tr
# QURAN_DATA_DIR=data
